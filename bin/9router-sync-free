#!/usr/bin/env python3
"""
9router-sync-free: Dynamic discovery and combo synchronization for free tier LLMs across OpenCode, Cline, and CommandCode into 9Router.
"""

import os
import sys
import json
import sqlite3
import datetime
import urllib.request
import argparse
import subprocess
import shutil

DEFAULT_DB_PATH = os.path.expanduser("~/.9router/db/data.sqlite")
DEFAULT_ROUTER_URL = "http://127.0.0.1:20128"

def log(msg):
    print(f"[{datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] {msg}")

def sync_opencode_free(db_path, opencode_bin=None):
    log("Checking OpenCode free models...")
    binary = opencode_bin or shutil.which("opencode") or os.path.expanduser("~/.opencode/bin/opencode")
    if not (os.path.exists(binary) and os.access(binary, os.X_OK)):
        log("  OpenCode binary not found or not executable. Skipping OpenCode sync.")
        return []

    try:
        out = subprocess.check_output([binary, "models"], text=True, stderr=subprocess.DEVNULL)
    except Exception as e:
        log(f"  Error running '{binary} models': {e}")
        return []

    raw_models = []
    for line in out.splitlines():
        line = line.strip()
        if line.startswith("opencode/"):
            name = line.split("/", 1)[1]
            if "free" in name.lower() or name == "big-pickle":
                raw_models.append(f"oc/{name}")

    seen = set()
    models = []
    for m in raw_models:
        if m not in seen:
            seen.add(m)
            models.append(m)

    priority_order = [
        "oc/mimo-v2.5-free",
        "oc/nemotron-3.5-lightning-free",
        "oc/nemotron-3-ultra-free",
        "oc/muse-spark-1.3-contributor-free",
        "oc/ling-3.0-flash-fin-free",
        "oc/muse-spark-1.2-contributor-free",
        "oc/big-pickle"
    ]
    sorted_models = [p for p in priority_order if p in models]
    for m in models:
        if m not in sorted_models:
            sorted_models.append(m)

    update_combo_in_db(db_path, "opencode-free", sorted_models)
    return sorted_models

def sync_cline_free(db_path, router_url):
    log("Checking Cline free models via 9Router catalog...")
    try:
        req = urllib.request.Request(f"{router_url}/v1/models")
        with urllib.request.urlopen(req, timeout=5) as resp:
            data = json.loads(resp.read().decode())
        all_models = [m["id"] for m in data.get("data", [])]
    except Exception as e:
        log(f"  Catalog fetch error: {e}")
        return []

    cline_free = [m for m in all_models if m.startswith("cl/") and "free" in m.lower()]
    priority = [
        "cl/google/gemma-4-26b-a4b-it:free",
        "cl/google/gemma-4-31b-it:free",
        "cl/nvidia/nemotron-3.5-lightning:free",
        "cl/z-ai/glm-5.2:free",
        "cl/inclusionai/ling-3.0-flash-fin:free"
    ]
    sorted_models = [m for m in priority if m in cline_free]
    for m in cline_free:
        if m not in sorted_models:
            sorted_models.append(m)

    update_combo_in_db(db_path, "cline-free", sorted_models)
    return sorted_models

def update_combo_in_db(db_path, combo_name, models):
    if not os.path.exists(db_path):
        log(f"  Database {db_path} does not exist. Skipping DB update.")
        return False
    if not models:
        return False

    try:
        db = sqlite3.connect(db_path)
        cur = db.cursor()
        now = datetime.datetime.now(datetime.timezone.utc).isoformat()
        models_json = json.dumps(models)

        cur.execute("SELECT id, models FROM combos WHERE name=?", (combo_name,))
        row = cur.fetchone()
        if row is None:
            import uuid
            cid = str(uuid.uuid4())
            cur.execute(
                "INSERT INTO combos (id, name, kind, models, createdAt, updatedAt) VALUES (?, ?, NULL, ?, ?, ?)",
                (cid, combo_name, models_json, now, now)
            )
            log(f"  Created combo '{combo_name}' with {len(models)} models.")
        else:
            cid, existing_models_raw = row
            try: existing_models = json.loads(existing_models_raw)
            except Exception: existing_models = []
            if existing_models != models:
                cur.execute(
                    "UPDATE combos SET models=?, updatedAt=? WHERE name=?",
                    (models_json, now, combo_name)
                )
                log(f"  Updated combo '{combo_name}' ({len(existing_models)} -> {len(models)} models).")
            else:
                log(f"  Combo '{combo_name}' is already up-to-date.")

        # Keep master 'free' combo up-to-date
        cur.execute("SELECT models FROM combos WHERE name='free'")
        f_row = cur.fetchone()
        if f_row:
            try: f_models = json.loads(f_row[0])
            except Exception: f_models = []
            if combo_name not in f_models:
                f_models.append(combo_name)
                cur.execute("UPDATE combos SET models=?, updatedAt=? WHERE name='free'", (json.dumps(f_models), now))
                log(f"  Linked '{combo_name}' into master 'free' combo.")

        db.commit()
        db.close()
        return True
    except Exception as e:
        log(f"  Database update failed: {e}")
        return False

def main():
    parser = argparse.ArgumentParser(description="Sync free-tier LLM providers into 9Router combos")
    parser.add_argument("--db", default=DEFAULT_DB_PATH, help="Path to 9router data.sqlite")
    parser.add_argument("--router-url", default=DEFAULT_ROUTER_URL, help="9Router base URL")
    parser.add_argument("--opencode-bin", default=None, help="Explicit path to opencode binary")
    args = parser.parse_args()

    log("=== Starting 9Router Free Combos Sync ===")
    sync_opencode_free(args.db, args.opencode_bin)
    sync_cline_free(args.db, args.router_url)
    log("=== Free Combos Sync Completed ===")

if __name__ == "__main__":
    main()
